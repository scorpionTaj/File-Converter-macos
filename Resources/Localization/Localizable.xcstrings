    "Only files you own that other users can't change are loaded. Recipes run with your permissions: add only commands you trust." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les fichiers qui vous appartiennent et que les autres utilisateurs ne peuvent pas modifier sont chargés. Les recettes s’exécutent avec vos autorisations : n’ajoutez que des commandes de confiance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se cargan los archivos que te pertenecen y que otros usuarios no pueden cambiar. Las recetas se ejecutan con tus permisos: añade solo comandos de confianza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Dateien, die dir gehören und die andere Benutzer nicht ändern können, werden geladen. Rezepte laufen mit deinen Rechten: Füge nur Befehle hinzu, denen du vertraust."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحمَّل إلا الملفات التي تملكها ولا يستطيع المستخدمون الآخرون تغييرها. تعمل الوصفات بصلاحياتك: أضف فقط أوامر تثق بها."
          }
        }
      }
    },

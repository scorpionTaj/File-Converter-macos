    "Kumquat installs helpers with Homebrew, the free macOS package manager. Install it from brew.sh, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat installe ses outils avec Homebrew, le gestionnaire de paquets gratuit pour macOS. Installez-le depuis brew.sh, puis réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat instala los complementos con Homebrew, el gestor de paquetes gratuito de macOS. Instálalo desde brew.sh y vuelve a intentarlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat installiert Hilfsprogramme mit Homebrew, dem kostenlosen Paketmanager für macOS. Installiere es von brew.sh und versuche es erneut."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يثبّت Kumquat الأدوات المساعدة عبر Homebrew، مدير الحزم المجاني لنظام macOS. ثبّته من brew.sh ثم أعد المحاولة."
          }
        }
      }
    },
    "Kumquat is enabled" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat est activé"

          }
        }
      }
    },
    "Kumquat is running from %@. Applications is the right home for it, and Launch at Login works best from there." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat s’exécute depuis %@. Sa place est dans Applications, et l’ouverture à la connexion y fonctionne le mieux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat se está ejecutando desde %@. Su sitio es Aplicaciones, y el inicio de sesión funciona mejor desde allí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat läuft aus %@. Der richtige Ort ist „Programme“, und „Beim Anmelden öffnen“ funktioniert dort am besten."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Kumquat من %@. مكانه الصحيح هو مجلد التطبيقات، ويعمل التشغيل عند تسجيل الدخول بشكل أفضل من هناك."
          }
        }
      }
    },
    "Kumquat is running from the disk image. Moving it to Applications keeps it available after you eject the image and lets it open at login." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat s’exécute depuis l’image disque. Le déplacer dans Applications le garde disponible après l’éjection et lui permet de s’ouvrir à la connexion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat se está ejecutando desde la imagen de disco. Moverlo a Aplicaciones lo mantiene disponible al expulsar la imagen y le permite abrirse al iniciar sesión."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat läuft aus dem Disk-Image. Im Ordner „Programme“ bleibt es nach dem Auswerfen verfügbar und kann beim Anmelden starten."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Kumquat من صورة القرص. نقله إلى مجلد التطبيقات يبقيه متاحاً بعد إخراج الصورة ويتيح فتحه عند تسجيل الدخول."
          }
        }
      }
    },

    "The disk image is open. Quit Kumquat, drag the new Kumquat onto Applications and choose Replace, then open it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image disque est ouverte. Quittez Kumquat, faites glisser le nouveau Kumquat sur Applications, choisissez Remplacer, puis rouvrez-le."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de disco está abierta. Sal de Kumquat, arrastra el nuevo Kumquat a Aplicaciones, elige Sustituir y vuelve a abrirlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Disk-Image ist geöffnet. Beende Kumquat, ziehe das neue Kumquat auf „Programme“, wähle „Ersetzen“ und öffne es wieder."
          }
        },

    "When off, dragging files and the Finder shortcut don't open a wheel. Also in the menu bar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, le glisser de fichiers et le raccourci du Finder n’ouvrent pas de roue. Aussi dans la barre des menus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, arrastrar archivos y el atajo del Finder no abren ninguna rueda. También en la barra de menús."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, öffnen Ziehen und der Finder-Kurzbefehl kein Rad. Auch in der Menüleiste."

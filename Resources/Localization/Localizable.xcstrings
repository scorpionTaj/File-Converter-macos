    "Kumquat will quit, replace itself with the new version and open again. Running conversions are stopped." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat va quitter, se remplacer par la nouvelle version et se rouvrir. Les conversions en cours sont arrêtées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat se cerrará, se sustituirá por la nueva versión y volverá a abrirse. Las conversiones en curso se detendrán."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumquat wird beendet, durch die neue Version ersetzt und wieder geöffnet. Laufende Konvertierungen werden gestoppt."
          }
        },
        "ar" : {

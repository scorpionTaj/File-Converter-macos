    "More is faster on Apple silicon but uses more memory. Video conversions already use every core." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus est plus rapide sur Apple silicon mais utilise plus de mémoire. Les conversions vidéo utilisent déjà tous les cœurs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más es más rápido en Apple silicon, pero usa más memoria. Las conversiones de vídeo ya usan todos los núcleos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr ist auf Apple silicon schneller, braucht aber mehr Speicher. Videokonvertierungen nutzen bereits alle Kerne."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العدد الأكبر أسرع على معالجات Apple لكنه يستهلك ذاكرة أكثر. تحويلات الفيديو تستخدم كل الأنوية أصلاً."
          }
        }
      }
    },

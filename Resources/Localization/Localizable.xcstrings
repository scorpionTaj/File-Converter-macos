    "Keys, quality, output, theme and recent files go back to their defaults. Kumquat will relaunch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touches, qualité, sortie, thème et fichiers récents reviennent aux valeurs par défaut. Kumquat va redémarrer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas, la calidad, la salida, el tema y los archivos recientes vuelven a sus valores predeterminados. Kumquat se reiniciará."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten, Qualität, Ausgabe, Thema und zuletzt verwendete Dateien werden zurückgesetzt. Kumquat startet neu."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود المفاتيح والجودة والإخراج والسمة والملفات الأخيرة إلى قيمها الافتراضية. سيُعاد تشغيل Kumquat."
          }
        }
      }
    },

    "One JSON file per recipe. {input} and {output} are replaced with file paths; the command runs directly, never through a shell, and is stopped after the timeout (seconds, at most 3600)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier JSON par recette. {input} et {output} sont remplacés par des chemins ; la commande s’exécute directement, jamais via un shell, et s’arrête après le délai (en secondes, 3600 au maximum)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo JSON por receta. {input} y {output} se sustituyen por rutas; el comando se ejecuta directamente, nunca a través de un shell, y se detiene tras el tiempo límite (segundos, 3600 como máximo)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine JSON-Datei pro Rezept. {input} und {output} werden durch Dateipfade ersetzt; der Befehl läuft direkt, nie über eine Shell, und wird nach dem Zeitlimit gestoppt (Sekunden, höchstens 3600)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف JSON لكل وصفة. يُستبدل {input} و{output} بمسارات الملفات؛ يعمل الأمر مباشرة، لا عبر الصدفة أبداً، ويتوقف بعد المهلة (بالثواني، 3600 كحد أقصى)."
          }
        }
      }
    },

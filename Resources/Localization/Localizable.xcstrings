          }
        }
      }
    },
    "Use kumquat-cli in Terminal (try kumquat-cli --help). Kumquat links it automatically when Homebrew's bin folder is writable; otherwise Install asks for your password and links it into /usr/local/bin." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez kumquat-cli dans le Terminal (essayez kumquat-cli --help). Kumquat le lie automatiquement si le dossier bin de Homebrew est accessible en écriture ; sinon Installer demande votre mot de passe et le lie dans /usr/local/bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa kumquat-cli en Terminal (prueba kumquat-cli --help). Kumquat lo enlaza automáticamente si se puede escribir en la carpeta bin de Homebrew; si no, Instalar pide tu contraseña y lo enlaza en /usr/local/bin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze kumquat-cli im Terminal (probiere kumquat-cli --help). Kumquat verlinkt es automatisch, wenn der bin-Ordner von Homebrew beschreibbar ist; sonst fragt „Installieren“ nach deinem Passwort und verlinkt es nach /usr/local/bin."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم kumquat-cli في الطرفية (جرّب kumquat-cli --help). يربطه Kumquat تلقائياً إذا كان مجلد bin الخاص بـ Homebrew قابلاً للكتابة؛ وإلا يطلب «تثبيت» كلمة السر ويربطه في ‎/usr/local/bin."
          }
        }
      }
    },
    "Use pages like 1, 3-5 or 2-." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez des pages comme 1, 3-5 ou 2-."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa páginas como 1, 3-5 o 2-."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Seiten wie 1, 3-5 oder 2- an."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم صفحات مثل 1، 3-5 أو 2-."
          }
        }
      }
    },
    "Use these settings for every conversion to %@. Page ranges aren't remembered." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser ces réglages pour chaque conversion en %@. Les plages de pages ne sont pas mémorisées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar estos ajustes en cada conversión a %@. Los rangos de páginas no se recuerdan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen für jede Konvertierung in %@ verwenden. Seitenbereiche werden nicht gemerkt."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام هذه الإعدادات لكل تحويل إلى %@. لا تُحفظ نطاقات الصفحات."
          }
        }
      }
    },
    "Used for conversions. Tools keep names like “IMG_0042 (compressed)”." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour les conversions. Les outils gardent des noms comme « IMG_0042 (compressed) »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa en las conversiones. Las herramientas mantienen nombres como «IMG_0042 (compressed)»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Konvertierungen. Werkzeuge behalten Namen wie „IMG_0042 (compressed)“."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم للتحويلات. تحتفظ الأدوات بأسماء مثل «IMG_0042 (compressed)»."
          }
        }
      }
    },
    "Version %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

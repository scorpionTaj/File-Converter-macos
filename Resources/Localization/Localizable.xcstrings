    "%@ is unreadable or password-protected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est illisible ou protégé par un mot de passe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se puede leer o está protegido con contraseña."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht lesbar oder passwortgeschützt."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ غير قابل للقراءة أو محمي بكلمة سر."
          }
        }
      }
    },
    "%@ is unreadable or password-protected. Use Tools → Unlock first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est illisible ou protégé par un mot de passe. Utilisez d’abord Outils → Déverrouiller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se puede leer o está protegido con contraseña. Usa primero Herramientas → Desbloquear."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht lesbar oder passwortgeschützt. Verwende zuerst Werkzeuge → Entsperren."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ غير قابل للقراءة أو محمي بكلمة سر. استخدم أولاً الأدوات ← إلغاء القفل."
          }
        }
      }
    },
